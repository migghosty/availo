generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// A booked appointment. Carries its own start time and duration — availability
/// is computed from the schedule rather than stored as pre-made slot rows, so a
/// booking is the only thing that needs to be materialized.
model Booking {
  id              Int      @id @default(autoincrement())
  startTime       DateTime @unique
  /// Copied from the booked Service, so repricing or relengthening a service
  /// later never resizes an appointment somebody already confirmed.
  durationMinutes Int
  clientName      String
  /// E.164, e.g. "+16191234567". Always written through normalizePhone() in
  /// lib/phone.ts so every spelling a client might type lands on one value —
  /// this is the /my-booking lookup key, and an exact match is all it does.
  clientPhone     String
  cancelToken     String   @unique
  createdAt       DateTime @default(now())

  /// Optional because bookings predating per-service durations have none, and
  /// because the name/price snapshot below is what the client-facing pages
  /// actually render. Restrict is the database-level backstop behind the
  /// booking-count guard in DELETE /api/services/[id].
  serviceId         Int?
  service           Service? @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceName       String   @default("")
  servicePriceCents Int      @default(0)

  /// When this client ticked the box agreeing to be texted. Null on bookings
  /// made before consent was collected. This is the evidence a carrier or a
  /// complaint would ask for, so it is recorded per booking rather than once
  /// per number — a per-appointment timestamp beats one stale agreement.
  smsConsentAt DateTime?

  /// Ties the rows of one back-to-back group booking together. A party of
  /// three is three rows, not one long one — that is what keeps every stored
  /// durationMinutes under MAX_DURATION_MINUTES (480), the assumption
  /// getRelevantBookings' 24-hour lookback rests on. A single row for four
  /// eight-hour services would be 32 hours long and quietly break it.
  ///
  /// Null for a solo booking. There is deliberately no groupSize or groupIndex
  /// column: size is the row count, order is startTime ascending, and
  /// cancellation is all-or-nothing, so both stay exact on their own. A stored
  /// copy could only ever disagree.
  groupId String?

  @@index([startTime])
  @@index([serviceId])
  @@index([clientPhone])
  @@index([groupId])
}

model Settings {
  id                 Int    @id @default(1)
  /// Granularity of offered start times (e.g. 15 => 4:00, 4:15, 4:30 …).
  /// How long an appointment lasts is NOT here — it belongs to each Service.
  slotIntervalMin    Int    @default(15)
  /// How many days ahead clients may book.
  bookingHorizonDays Int    @default(30)
  /// Where appointments happen. Free text (may be multi-line) so the admin can
  /// write it the way clients would search for it. Empty means "not set", in
  /// which case calendar events simply carry no location.
  address            String @default("")
  /// Where booking notifications are texted. E.164, normalized by lib/phone.ts.
  /// Empty means "not set" and admin texts are skipped entirely — same
  /// convention as `address` above.
  adminPhone         String @default("")
  /// The trading name clients see: in every text, in calendar event titles, on
  /// the policy pages and in the public header. Must match the brand registered
  /// with the carriers for A2P 10DLC, or the sample messages submitted there
  /// won't match what actually gets sent — a common rejection reason.
  businessName       String @default("Availo")
}

/// One row per number that has texted STOP.
///
/// Twilio blocks these at its end regardless, so this is not what enforces the
/// opt-out. It exists so the app can say *why* someone stopped hearing from us
/// instead of appearing broken, and so we don't spend an API call being told no.
model SmsOptOut {
  /// E.164, the same canonical form as Booking.clientPhone.
  phone      String   @id
  optedOutAt DateTime @default(now())
}

/// Recurring weekly availability. One row per open window per weekday, so a day
/// can have several windows (e.g. 9am–12pm and 2pm–5pm). A weekday with no rows
/// is closed.
model ScheduleRule {
  id          Int @id @default(autoincrement())
  /// 0 = Sunday … 6 = Saturday
  dayOfWeek   Int
  /// Minutes from midnight in BUSINESS_TIMEZONE.
  startMinute Int
  endMinute   Int

  @@index([dayOfWeek])
}

/// A one-off exception for a specific calendar date. Fully replaces that day's
/// weekly rules: either closed outright, or its own set of windows.
model ScheduleOverride {
  id       Int                      @id @default(autoincrement())
  /// YYYY-MM-DD as observed in BUSINESS_TIMEZONE.
  date     String                   @unique
  isClosed Boolean                  @default(false)
  windows  ScheduleOverrideWindow[]
}

model ScheduleOverrideWindow {
  id          Int              @id @default(autoincrement())
  overrideId  Int
  startMinute Int
  endMinute   Int
  override    ScheduleOverride @relation(fields: [overrideId], references: [id], onDelete: Cascade)

  @@index([overrideId])
}

/// Something a client can book. Carries the appointment length, so choosing a
/// service is what determines which start times are even offered.
model Service {
  id              Int      @id @default(autoincrement())
  name            String
  emoji           String   @default("")
  priceCents      Int
  /// How long this service takes — a booking of it blocks this much time.
  durationMinutes Int      @default(30)
  /// Archived services disappear from the client flow but keep their row, so
  /// bookings that reference them stay intact. Hard deletion is only allowed
  /// while nothing references the service.
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  bookings Booking[]
}

/// One browser that has agreed to receive push notifications.
///
/// **Admin-only, and single-tenant** — there is no owner column because there
/// is exactly one admin, and the subscribe endpoints sit behind their session.
/// Do not read this as a general "subscriptions" table: sending to clients
/// would need an owner and a consent timestamp, the way `Booking.smsConsentAt`
/// records consent per appointment.
///
/// One row per browser, not per person: the admin's phone and their laptop are
/// two subscriptions, and reinstalling the home-screen app produces a third.
/// The stale ones are not cleaned up by hand — `lib/webPush.ts` deletes any
/// endpoint the push service reports as gone.
model PushSubscription {
  id            Int       @id @default(autoincrement())
  /// The push service URL this browser was handed (web.push.apple.com for iOS,
  /// fcm.googleapis.com for Chrome). Unique because it *is* the identity — a
  /// re-subscribe returns the same endpoint and must update, not duplicate.
  endpoint      String    @unique
  /// The subscription's public key and auth secret, used to encrypt the
  /// payload. Opaque base64url to us; `web-push` does the crypto.
  p256dh        String
  auth          String
  /// Whatever browser registered it, purely so a list of subscriptions is
  /// recognizable ("iPhone" vs "Mac") when deciding whether to remove one.
  userAgent     String    @default("")
  createdAt     DateTime  @default(now())
  /// Last time a push to this endpoint was accepted. Null until the first send.
  lastSuccessAt DateTime?
}
